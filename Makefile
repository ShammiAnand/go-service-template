# Run `make help` for the list. `make check` is the gate before any commit.
SHELL := /bin/bash
.DEFAULT_GOAL := help

TOOL      := go tool -modfile=tools/go.mod
COMPOSE   := docker compose
GEN_HEADER := \# Code generated by `make gen`. DO NOT EDIT.

## help: list targets
help:
	@grep -E '^## ' $(MAKEFILE_LIST) | sed 's/^## //' | column -t -s ':'

## up: start the full local stack (api, worker, postgres, redis, keycloak, mailpit, jaeger)
up:
	$(COMPOSE) up -d --build --wait

## down: stop the stack (keeps volumes)
down:
	$(COMPOSE) down

## nuke: stop the stack and delete its volumes
nuke:
	$(COMPOSE) down -v

## deps: start only the dependencies, for `make run` on the host
deps:
	$(COMPOSE) up -d --wait postgres redis keycloak mailpit jaeger

## run: run the API on the host against `make deps` (reads .env)
run:
	set -a; source .env; set +a; go run ./cmd/app serve

## worker: run the job worker on the host (reads .env)
worker:
	set -a; source .env; set +a; go run ./cmd/app worker

## migrate-up: apply migrations (reads .env)
migrate-up:
	set -a; source .env; set +a; go run ./cmd/app migrate up

## migrate-down: roll back one migration (reads .env)
migrate-down:
	set -a; source .env; set +a; go run ./cmd/app migrate down

## migrate-new: create a migration, NAME=add_users
migrate-new:
	@test -n "$(NAME)" || (echo "usage: make migrate-new NAME=add_users" && exit 2)
	go run ./cmd/app migrate-new $(NAME)

## gen: regenerate sqlc code and api/openapi.yaml
gen:
	$(TOOL) sqlc generate
	@{ echo '$(GEN_HEADER)'; go run ./cmd/app openapi; } > api/openapi.yaml

## fmt: format code
fmt:
	$(TOOL) golangci-lint fmt ./...

## lint: run linters
lint:
	$(TOOL) golangci-lint run ./...

## test: unit tests (no Docker)
test:
	go test -race -count=1 ./...

## test-int: integration tests (needs Docker)
test-int:
	go test -race -count=1 -tags integration ./...

## vuln: scan dependencies for known vulnerabilities
vuln:
	$(TOOL) govulncheck ./...

## check: everything CI runs. Run before calling work done.
check: fmt gen
	@git diff --exit-code -- api internal/db/dbgen || (echo "generated files changed: commit them" && exit 1)
	$(MAKE) lint test test-int

## token: print a dev access token for user dev/dev from local Keycloak
token:
	@curl -fsS -d grant_type=password -d client_id=cli -d username=dev -d password=dev \
	  http://localhost:8081/realms/app/protocol/openid-connect/token | sed -E 's/.*"access_token":"([^"]+)".*/\1/'

## rename: rename the module and service, MODULE=github.com/acme/billing NAME=billing
rename:
	@test -n "$(MODULE)" -a -n "$(NAME)" || (echo "usage: make rename MODULE=github.com/acme/billing NAME=billing" && exit 2)
	./scripts/rename.sh "$(MODULE)" "$(NAME)"

## build: build the binary into bin/app
build:
	CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o bin/app ./cmd/app

.PHONY: help up down nuke deps run worker migrate-up migrate-down migrate-new gen fmt lint test test-int vuln check token rename build
