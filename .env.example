# Copy to .env for `make run` / `make worker` on the host after `make deps`.
# DEV ONLY values. Never commit .env.
APP_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
REDIS_URL=redis://localhost:6379/0
AUTH_ISSUER_URL=http://localhost:8081/realms/app
AUTH_AUDIENCE=api
EMAIL_DRIVER=smtp
EMAIL_FROM=no-reply@example.com
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_TLS=none
JOBS_DRIVER=asynq
OBSERVABILITY_DRIVER=otel
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
HTTP_CORS_ORIGINS=http://localhost:3000
